# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY=

# Supabase — client-side (safe to expose, protected by Row Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — server-side only, NEVER prefix with VITE_ / never ship to the client.
# Used by serverless functions (e.g. the Kirvano webhook) to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Kirvano webhook shared secret/token, validated in api/webhooks/kirvano.ts
KIRVANO_WEBHOOK_TOKEN=
