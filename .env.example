# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
GEMINI_API_KEY=

# Supabase — client-side (safe to expose, protected by Row Level Security)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — server-side only, NEVER prefix with VITE_ / never ship to the client.
# Used by serverless functions (e.g. the Applyfy webhook) to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Applyfy webhook shared secret, appended as ?token=... on the webhook URL
# registered in the Applyfy dashboard. Validated in api/webhooks/applyfy.ts
APPLYFY_WEBHOOK_TOKEN=
